# Copy to .env.local for local development. Never commit real credentials.
# The API and adapters are not implemented in M0; values are intentionally blank.

NODE_ENV=development
API_PORT=3001
CONSOLE_URL=http://localhost:3000

# Neon catalog and relational primary
DATABASE_URL=
DATABASE_URL_POOLED=
NEON_PROJECT_ID=
NEON_BRANCH=
NEON_FUNCTION_API_URL=

# Neon Object Storage
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
S3_BUCKET=coltbucket

# Neon AI Gateway; only usable when enabled on the Neon project
NEON_AI_GATEWAY_BASE_URL=
NEON_AI_GATEWAY_TOKEN=

# Supabase tenant Postgres (blocked until backup and restore verification)
SUPABASE_DATABASE_URL=

# MongoDB Atlas
MONGODB_URI=
MONGODB_USERNAME=
MONGODB_PASSWORD=

# Firebase Firestore; placeholder until credentials are issued
FIREBASE_PROJECT_ID=replace-me
FIREBASE_CLIENT_EMAIL=replace-me
FIREBASE_PRIVATE_KEY=replace-me

# Upstash Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REDIS_URL=

# Optional provider credentials only; Appwrite/Turso adapters are not in v1 scope
APPWRITE_API_KEY=
APPWRITE_ENDPOINT=
APPWRITE_PROJECT_ID=
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Cloudflare R2 and D1
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
D1_DATABASE_ID=
D1_DATABASE_TOKEN=

# Upstash Blob, QStash, and Workflow
UPSTASH_BLOB_TOKEN=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
UPSTASH_WORKFLOW_URL=

# Authentication and application secrets
BETTER_AUTH_SECRET=replace-with-at-least-32-random-bytes
BETTER_AUTH_URL=http://localhost:3001
ENCRYPTION_KEY=replace-with-deployment-secret

# Operational limits and invite gate
SIGNUP_ALLOWLIST=
GLOBAL_KILL_SWITCH=false